# ==================================================
# Herbix Backend — Environment Configuration
# ==================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is already gitignored.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example:   mongodb://127.0.0.1:27017/herbix
# Atlas example:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/herbix
MONGODB_URI=mongodb://127.0.0.1:27017/herbix

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — the frontend origin(s) allowed to call this API
CLIENT_URL=http://localhost:5173

# Seed script only — used once to create the initial admin account.
# Not used by the running app after seeding.
ADMIN_NAME=Herbix Admin
ADMIN_EMAIL=admin@herbix.local
ADMIN_PASSWORD=replace_with_a_strong_password
